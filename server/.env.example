# Copy to .env and fill. Do not commit .env.
# AZURE_SENDER_EMAIL must be from a domain linked in Azure (see README → Fix "DomainNotLinked").
PORT=5000
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://....communication.azure.com/;accesskey=...
AZURE_SENDER_EMAIL=DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net
CONTACT_RECIPIENT_EMAIL=info@cloudsurge.uk
